# Opcional: overrides solo del backend. Si usas un solo `.env` en la raíz del repo,
# no hace falta copiar esto; `app.config` ya carga `../.env` primero.

NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=info

DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379

DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=America/Lima

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-this-key
EVOLUTION_INSTANCE=rutepe
EVOLUTION_WEBHOOK_TOKEN=change-this-webhook-token
EVOLUTION_MY_PHONE=519000000000
EVOLUTION_SELF_CHAT_MODE=only
EVOLUTION_ALLOWED_JIDS=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SEND_MODE=off

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
