NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=info

DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nekobot?schema=public

REDIS_URL=redis://localhost:6379

DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=America/Lima

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-this-key
EVOLUTION_INSTANCE=rutepe
# Déjalo vacío en local si Evolution no envía el mismo token en el webhook
EVOLUTION_WEBHOOK_TOKEN=

# Tu celular con código Perú, solo dígitos (activa “solo mi chat”)
EVOLUTION_MY_PHONE=51955256450
# NEKOBOT-style: only = solo "Mensajes contigo" (tú↔tú); allow = también otros chats; disabled = nunca fromMe
EVOLUTION_SELF_CHAT_MODE=only
EVOLUTION_ALLOWED_JIDS=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=955256450
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SEND_MODE=off
WHATSAPP_REPLY_DEBOUNCE_SEC=0

# Copiá tus claves reales en `.env` (no subas claves al repo).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL="gpt-4o"
ANTHROPIC_MODEL="claude-opus-4-6"
OPENAI_EMBEDDINGS_MODEL="text-embedding-3-small"

AUTHENTICATION_API_KEY=change-this-key