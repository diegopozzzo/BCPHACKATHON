# Referencia para variables del BACKEND (FastAPI) y alineación con Docker Evolution.
# Para levantar Evolution: en la raíz del repo, copia también valores a un .env que use
# docker compose (AUTHENTICATION_API_KEY debe ser IGUAL a EVOLUTION_API_KEY del backend).

NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=info

DATABASE_URL=sqlite:///./data/app.db

REDIS_URL=redis://localhost:6379

DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=America/Lima

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-this-key
EVOLUTION_INSTANCE=rutepe
EVOLUTION_WEBHOOK_TOKEN=

EVOLUTION_MY_PHONE=519000000000
EVOLUTION_SELF_CHAT_MODE=only
EVOLUTION_ALLOWED_JIDS=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SEND_MODE=off

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Misma cadena que EVOLUTION_API_KEY (usada por el servicio evolution-api del compose).
AUTHENTICATION_API_KEY=change-this-key
