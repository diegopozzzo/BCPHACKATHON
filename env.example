# Plantilla: copia a `.env` en la raíz del repo (`copy env.example .env`) y edita allí.
# No pongas claves reales en env.example (sí en `.env`, que está en .gitignore).

NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=info

DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nekobot?schema=public

REDIS_URL=redis://localhost:6379

DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=America/Lima

# URL donde corre Evolution (docker-compose publica 8080). Si falla con localhost en Windows, prueba 127.0.0.1.
EVOLUTION_API_URL=http://localhost:8080
# Opcional (solo compose): versión WhatsApp Web si el QR devuelve count:0. Por defecto ya va en docker-compose.yml.
# CONFIG_SESSION_PHONE_VERSION=2.3000.1037700952
# Debe coincidir con AUTHENTICATION_API_KEY del servicio evolution-api en docker-compose.yml.
EVOLUTION_API_KEY=change-this-key
EVOLUTION_INSTANCE=rutepe
# Déjalo vacío en local si Evolution no envía el mismo token en el webhook
EVOLUTION_WEBHOOK_TOKEN=

# Tu celular con código Perú, solo dígitos (activa “solo mi chat”)
EVOLUTION_MY_PHONE=519000000000
# NEKOBOT: only | allow | disabled (ver README)
EVOLUTION_SELF_CHAT_MODE=only
# Legacy (si no usas SELF_CHAT_MODE): EVOLUTION_ALLOW_FROM_ME=false
EVOLUTION_ALLOWED_JIDS=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SEND_MODE=off

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Opcional: protege el panel /admin
# ADMIN_DASHBOARD_TOKEN=

AUTHENTICATION_API_KEY=change-this-key
